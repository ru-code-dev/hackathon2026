{
  "name": "ds-analyzer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Static analysis toolkit for the sds-eng design system: extracts the UI kit specification into machine-readable artifacts.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "extract:tokens": "tsx src/cli/extract-tokens.ts",
    "extract:components": "tsx src/cli/extract-components.ts",
    "extract:kit-a11y": "tsx src/cli/extract-kit-a11y.ts",
    "extract:icons": "tsx src/cli/extract-icons.ts",
    "extract": "tsx src/cli/extract-all.ts",
    "scan": "tsx src/cli/scan.ts",
    "analyze": "tsx src/cli/analyze.ts",
    "dashboard:build": "npm --prefix dashboard ci --no-audit --no-fund && npm --prefix dashboard run build",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "build:skills": "tsx scripts/build-skills.ts",
    "skill": "tsx src/cli/skill-main.ts"
  },
  "dependencies": {
    "aria-query": "^5.3.2",
    "esbuild": "^0.25.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "ignore": "^7.0.6",
    "postcss": "^8.5.24",
    "postcss-scss": "^4.0.9",
    "shiki": "^4.3.1",
    "ts-morph": "^25.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/aria-query": "^5.0.4",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
