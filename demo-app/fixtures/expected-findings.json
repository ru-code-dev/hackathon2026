    "styleSyntaxes": ["scss-modules", "styled-components", "inline-style"],
    "aliases": ["@/*"],
    "note": [
      "`@/shared/ui` is only reachable through the transitive re-export closure of §3bis.4;",
      "a scanner that only looks for @sds-eng/* specifiers will miss the Button in App.tsx."
    ]
  },
