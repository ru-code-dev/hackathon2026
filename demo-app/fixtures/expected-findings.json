{
  "$schema": "ds-analyzer/expected-findings@1",
  "about": [
    "Hand-authored ground truth for the deviation detectors. Every entry was derived by",
    "reading the fixture source and cross-checking the value against ds-analyzer/artifacts/",
    "tokens.json — the subkinds and expected tokens below are measured, not guessed.",
    "",
    "The analyser is scored against this file: recall = matched / expectations, precision =",
    "matched / reported. A finding matches an expectation when file, line, rule and actual",
    "all agree; subkind and expect are then asserted on the matched pair.",
    "",
    "`stage` says which milestone enforces the entry. M3 covers the token and API rules;",
    "M5 covers the component rules, which need the kit signature index."
  ],
  "conventions": {
    "dimensionProperties": [
      "Only properties for which the kit either has a scale or a per-component token take",
      "part in dimension rules: border-radius*, border*-width, outline-width, font-size,",
      "line-height, letter-spacing, padding*, gap, row-gap, column-gap.",
      "width/height/min-*/max-*/margin*/inset/top/right/bottom/left are layout, not design:",
      "there is no token to suggest, so reporting them would be noise."
    ],
    "zeroIsNotAFinding": "A dimension of 0 in any unit carries no design decision.",
    "cssKeywordsAreNotColours": "transparent, currentColor, inherit, initial, unset, none.",
    "colourLiteralsInTypeScript": [
      "Inside .ts/.tsx string literals only hex and functional rgb()/hsl() notations count.",
      "Bare keywords are excluded there: 'black' is far more likely an identifier than a colour.",
      "Inside a CSS declaration the property name provides the context, so keywords count."
    ],
    "alphaMustMatch": [
      "Nearest-token search only considers tokens whose alpha is within 0.02 of the literal.",
      "Suggesting a solid colour for a 12%-opacity shadow would be wrong advice, and OKLab",
      "distance alone cannot see the difference — it is computed on RGB only."
    ],
    "overridesAreGroupedPerClass": [
      "One style.override.* finding per (CSS class, category), anchored at the first offending",
      "declaration. Per-declaration reporting turns a single repaint into five findings.",
      "A declaration carrying !important yields style.override.important and nothing else."
    ],
    "scssVariableDeclarationsAreNotFindings": [
      "A finding is reported at the usage site and carries rootCause pointing at the",
      "declaration. Reporting the declaration separately would double-count."
    ]
  },
  "cleanFiles": [
    "src/main.tsx",
    "src/features/auth/LoginForm.tsx",
    "src/features/orders/OrderTable.tsx",
    "src/shared/ui/index.ts"
  ],
  "excludedFiles": [
    {
      "file": "src/generated/ApiTypes.tsx",
      "reason": "matched by the project .gitignore; must not be walked at all"
    }
  ],
  "expectedLimitations": [
    {
      "file": "src/shared/ui/MyButton.tsx",
      "line": 31,
      "reason": "dynamic-styles",
      "detail": "styled-components interpolation `${(props) => VIEW_COLORS[props.$view]}`"
    },
    {
      "file": "src/shared/ui/MyButton.tsx",
      "line": 32,
      "reason": "dynamic-styles",
      "detail": "styled-components interpolation `${(props) => SIZE_PADDING[props.$size]}`"
    }
  ],
  "expectedProfile": {
